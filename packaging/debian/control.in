Depends: ${shlibs:Depends}, ${misc:Depends}, bubblewrap, util-linux, desktop-file-utils, hicolor-icon-theme, libfontconfig1, libfreetype6, libxkbcommon0, libxkbcommon-x11-0, libwayland-client0, libwayland-cursor0, libvulkan1, libgl1, libegl1, libx11-6, libxcursor1, libxi6, libxrandr2, libxcb1, libasound2t64 | libasound2, libpipewire-0.3-0t64 | libpipewire-0.3-0, pipewire-bin, libpipewire-0.3-modules, libspa-0.2-modules, libpulse0
Description: Voice and text chat for Mumble servers
