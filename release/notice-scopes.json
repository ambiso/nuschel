{
  "all": {
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "wasm32-unknown-unknown"
    ],
    "external_components": [
      "rust-standard-library",
      "gcc-runtime",
      "mingw-w64-runtime",
      "newcm-math-font",
      "syntect-default-assets",
      "web-runtime-assets",
      "musicbot-web-runtime-assets"
    ],
    "root_group": "all"
  },
  "linux-nix": {
    "targets": [
      "x86_64-unknown-linux-gnu"
    ],
    "external_components": [
      "rust-standard-library",
      "newcm-math-font",
      "syntect-default-assets"
    ]
  },
  "windows-x86_64": {
    "targets": [
      "x86_64-pc-windows-gnu"
    ],
    "external_components": [
      "rust-standard-library",
      "gcc-runtime",
      "mingw-w64-runtime",
      "newcm-math-font",
      "syntect-default-assets"
    ]
  },
  "macos-universal": {
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin"
    ],
    "external_components": [
      "rust-standard-library",
      "newcm-math-font",
      "syntect-default-assets"
    ]
  },
  "web": {
    "targets": [
      "wasm32-unknown-unknown"
    ],
    "external_components": [
      "rust-standard-library",
      "syntect-default-assets",
      "web-runtime-assets"
    ]
  },
  "linux-aarch64-nix": {
    "targets": [
      "aarch64-unknown-linux-gnu"
    ],
    "external_components": [
      "rust-standard-library",
      "newcm-math-font",
      "syntect-default-assets"
    ]
  },
  "rtc-probe-x86_64-unknown-linux-gnu": {
    "targets": [
      "x86_64-unknown-linux-gnu"
    ],
    "root_group": "rtc-probe",
    "external_components": [
      "rust-standard-library"
    ]
  },
  "rtc-probe-aarch64-unknown-linux-gnu": {
    "targets": [
      "aarch64-unknown-linux-gnu"
    ],
    "root_group": "rtc-probe",
    "external_components": [
      "rust-standard-library"
    ]
  },
  "rtc-probe-x86_64-apple-darwin": {
    "targets": [
      "x86_64-apple-darwin"
    ],
    "root_group": "rtc-probe",
    "external_components": [
      "rust-standard-library"
    ]
  },
  "rtc-probe-aarch64-apple-darwin": {
    "targets": [
      "aarch64-apple-darwin"
    ],
    "root_group": "rtc-probe",
    "external_components": [
      "rust-standard-library"
    ]
  },
  "musicbot-x86_64-unknown-linux-gnu": {
    "targets": ["x86_64-unknown-linux-gnu"],
    "root_group": "musicbot",
    "external_components": ["rust-standard-library", "musicbot-web-runtime-assets"]
  },
  "musicbot-aarch64-unknown-linux-gnu": {
    "targets": ["aarch64-unknown-linux-gnu"],
    "root_group": "musicbot",
    "external_components": ["rust-standard-library", "musicbot-web-runtime-assets"]
  },
  "musicbot-x86_64-apple-darwin": {
    "targets": ["x86_64-apple-darwin"],
    "root_group": "musicbot",
    "external_components": ["rust-standard-library", "musicbot-web-runtime-assets"]
  },
  "musicbot-aarch64-apple-darwin": {
    "targets": ["aarch64-apple-darwin"],
    "root_group": "musicbot",
    "external_components": ["rust-standard-library", "musicbot-web-runtime-assets"]
  }
}
