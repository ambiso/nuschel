#!/usr/bin/env bash
# SPDX-License-Identifier: EUPL-1.2
# Print the Nix installables of one CI tier, one per line, for
# .github/workflows/check.yml and scripts/pre-pr (the same lists for both).
#
#   scripts/ci-tiers [--flake REF] [--system SYSTEM] TIER
#
# Per pull request and push (tier 1):
#   build    Linux packages: desktop/terminal/helpers, server, RTC probe, web relay, web site
#   lint     workspace Clippy (--all-targets --deny warnings) and rustfmt
#   unit     every other per-PR flake check: unit-test leaves, worker-boundary
#            checks, dependency/advisory policy, the crate2nix graph, modules
#   fast     build + lint + unit
# Main pushes, the nightly schedule and manual runs (tier 2):
#   nightly  NixOS VM fixtures
# Release proofs (tier 3; also built nightly):
#   release  Linux distribution packaging proofs
#
# Once the flake provides legacyPackages.<system>.nightlyChecks and
# .releaseChecks, `checks` is exactly tier 1 and those sets are tiers 2 and 3.
# Until then `checks` holds all three: vm-* checks are tier 2 and distro-*
# checks tier 3. Windows/macOS cross builds and release archives are not flake
# checks; .github/workflows/build.yml builds them for releases and on demand.
set -euo pipefail

flake=.
system=x86_64-linux
while (( $# > 1 )); do
  case $1 in
    --flake) flake=$2; shift 2 ;;
    --system) system=$2; shift 2 ;;
    *) break ;;
  esac
done
(( $# == 1 )) || { echo "usage: $0 [--flake REF] [--system SYSTEM] build|lint|unit|fast|nightly|release" >&2; exit 2; }
tier=$1

build_checks=(build server-build rtc-build)
build_packages=(web-relay web-site)
lint_checks=(clippy fmt)

names() {
  nix eval --raw "$flake#$1" --apply 's: builtins.concatStringsSep " " (builtins.attrNames s)'
}
emit() {
  local prefix=$1 name
  shift
  for name in "$@"; do printf '%s#%s%s\n' "$flake" "$prefix" "$name"; done
}

split=$(nix eval --raw "$flake#legacyPackages.$system" \
  --apply 'p: if p ? nightlyChecks && p ? releaseChecks then "flake" else "none"' 2>/dev/null || echo none)

list=$(names "checks.$system")
read -r -a all <<<"$list"
fast_names=()
nightly_names=()
release_names=()
if [[ $split == flake ]]; then
  fast_names=("${all[@]}")
  list=$(names "legacyPackages.$system.nightlyChecks")
  read -r -a nightly_names <<<"$list"
  list=$(names "legacyPackages.$system.releaseChecks")
  read -r -a release_names <<<"$list"
  nightly_prefix="legacyPackages.$system.nightlyChecks."
  release_prefix="legacyPackages.$system.releaseChecks."
else
  for name in "${all[@]}"; do
    case $name in
      vm-*) nightly_names+=("$name") ;;
      distro-*) release_names+=("$name") ;;
      *) fast_names+=("$name") ;;
    esac
  done
  nightly_prefix="checks.$system."
  release_prefix="checks.$system."
fi

unit_names=()
for name in "${fast_names[@]}"; do
  case " ${build_checks[*]} ${lint_checks[*]} " in
    *" $name "*) ;;
    *) unit_names+=("$name") ;;
  esac
done

case $tier in
  build)
    emit "checks.$system." "${build_checks[@]}"
    emit "" "${build_packages[@]}"
    ;;
  lint) emit "checks.$system." "${lint_checks[@]}" ;;
  unit) emit "checks.$system." "${unit_names[@]}" ;;
  fast)
    emit "checks.$system." "${build_checks[@]}" "${lint_checks[@]}" "${unit_names[@]}"
    emit "" "${build_packages[@]}"
    ;;
  nightly) emit "$nightly_prefix" "${nightly_names[@]}" ;;
  release) emit "$release_prefix" "${release_names[@]}" ;;
  *) echo "unknown tier: $tier" >&2; exit 2 ;;
esac
