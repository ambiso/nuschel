# Two private guests; real lego/Pebble HTTP01, no public CA/DNS or Rust rebuild.
{
  projectRoot ? ../.,
  packagePath,
}:
let
  flake = builtins.getFlake (toString projectRoot);
  pkgs = flake.inputs.nixpkgs.legacyPackages.x86_64-linux;
  package = pkgs.runCommand "nuschl-cached-http01-vm-package" { } ''
    ln -s ${builtins.storePath packagePath} "$out"
  '';
  testSupport = flake.inputs.nixpkgs.outPath + "/nixos/tests/common/acme";
in
pkgs.testers.runNixOSTest {
  name = "nuschl-private-http01";
  nodes = {
    acme = { ... }: {
      # Upstream's intentionally public snakeoil FRONTEND credentials, never
      # operator secrets. Issuance roots/keys are freshly generated by Pebble.
      imports = [ (testSupport + "/server") ];
      systemd.services.pebble.environment.PEBBLE_AUTHZREUSE = "0";
      virtualisation = {
        memorySize = 768;
        cores = 2;
        diskSize = 1024;
      };
    };
    server =
      {
        config,
        lib,
        pkgs,
        ...
      }:
      {
        imports = [
          (import ../nix/module.nix { self = flake; })
          (testSupport + "/client")
        ];
        networking.hosts."127.0.0.1" = [
          "voice.test"
          "web.test"
          "witness.test"
        ];
        networking.firewall.allowedTCPPorts = [
          80
          443
          64738
        ];
        services.nuschl = {
          enable = true;
          inherit package;
          hostName = "voice.test";
          tls = {
            enableACME = true;
            nginxHTTP01 = true;
          };
          kt = {
            defaultWitnesses = false;
            origins = [ ];
          };
          settings.autoban.attempts = 0;
        };
        services.nginx = {
          enable = true;
          virtualHosts = {
            "web.test" = {
              enableACME = true;
              forceSSL = true;
              locations."/".return = ''200 "private web fixture"'';
            };
            "witness.test" = {
              enableACME = true;
              forceSSL = true;
              locations."/".return = ''200 "private witness fixture"'';
            };
          };
        };
        # Deliberately model an existing broad ACME membership. Voice key access
        # must still fail; only the new private group owns that certificate.
        users.users.nginx.extraGroups = [ "acme" ];
        security.acme.certs."voice.test".validMinDays = 365;
        systemd.services.nuschl.wantedBy = lib.mkForce [ ];
        systemd.services.nuschl-tls-refresh.serviceConfig = {
          # Test-only public trust injection: Pebble generates its issuer root
          # on launch. ONLY this unit sees the bind over the compiled CA bundle;
          # the production publisher script and host/global CA bytes are unchanged.
          BindReadOnlyPaths = [ "/run/http01-test/issuer.pem:${config.security.pki.caBundle}" ];
          ExecStartPre = "${pkgs.coreutils}/bin/sleep 1";
        };
        systemd.timers.nuschl-tls-refresh.timerConfig = {
          OnBootSec = lib.mkForce "5min";
          OnUnitInactiveSec = lib.mkForce "5s";
        };
        environment.systemPackages = [
          pkgs.openssl
          pkgs.python3
          pkgs.util-linux
          pkgs.curl
        ];
        environment.etc."http01-test-config.json".text = builtins.toJSON {
          caBundle = config.security.pki.caBundle;
          frontendCA = flake.inputs.nixpkgs.outPath + "/nixos/tests/common/acme/server/ca.cert.pem";
          nginxCommand = config.systemd.services.nginx.serviceConfig.ExecStart;
          publisherCommand = config.systemd.services.nuschl-tls-refresh.serviceConfig.ExecStart;
        };
        virtualisation = {
          memorySize = 1536;
          cores = 2;
          diskSize = 1024;
        };
      };
  };
  testScript = ''
    from pathlib import Path

    # Assert actual driver paths BEFORE boot, not merely client TMPDIR.
    exec(Path("${./vm_driver_scratch.py}").read_text())
    acme.start()
    acme.wait_for_unit("pebble.service")
    acme.wait_for_open_port(443)
    acme.succeed("test -z \"$(systemctl show pebble -p Environment --value | grep PEBBLE_VA_ALWAYS_VALID || true)\"")
    server.start()
    server.wait_for_unit("multi-user.target")
    server.wait_for_unit("nginx.service")
    try:
        server.succeed("python3 ${./server_http01_vm.py} --pki-helper ${./server_pki_vm.py}", timeout=360)
    finally:
        server.succeed("journalctl -u nuschl -u nuschl-tls-refresh -u 'acme-*' --no-pager > /tmp/http01-journal.txt")
        server.copy_from_machine("/tmp/http01-journal.txt")
        server.copy_from_machine("/var/log/nginx/access.log")
        acme.succeed("journalctl -u pebble --no-pager > /tmp/pebble-journal.txt")
        acme.copy_from_machine("/tmp/pebble-journal.txt")
        if server.succeed("test -f /run/http01-test/proof.json && echo yes || true").strip() == "yes":
            server.copy_from_machine("/run/http01-test/proof.json")
        for public in server.succeed("find /run/http01-test -maxdepth 1 -name 'public-*.pem'").splitlines():
            server.copy_from_machine(public)
  '';
}
