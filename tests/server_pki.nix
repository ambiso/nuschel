# Evaluate without an ACME network call. Only the fixture CA's PUBLIC certificate
# may enter the store; its private keys are generated by server_pki.py on disk.
{
  projectRoot ? ../.,
  trustedCaFile ? null,
  variant ? "acme",
}:
let
  flake = builtins.getFlake (toString projectRoot);
  lib = flake.inputs.nixpkgs.lib;
  test = lib.nixosSystem {
    system = "x86_64-linux";
    modules = [
      (import (projectRoot + /nix/module.nix) { self = flake; })
      ({ pkgs, ... }: {
        system.stateVersion = "26.11";
        boot.isContainer = true;
        services.nuschl = {
          enable = true;
          package = pkgs.writeShellScriptBin "nuschld" "exit 0";
          hostName = if variant == "missing-host" then null else "voice.test";
          tls =
            if variant == "manual" then
              {
                certificateFile = "/private/fullchain.pem";
                keyFile = "/private/key.pem";
              }
            else if variant == "store-key" then
              {
                certificateFile = "/private/fullchain.pem";
                keyFile = "/nix/store/forbidden-private-key.pem";
              }
            else if variant == "self-signed" then
              { }
            else if variant == "reuse" then
              { useACMEHost = "shared.test"; }
            else if variant == "conflict" then
              {
                enableACME = true;
                keyFile = "/private/key.pem";
                certificateFile = "/private/cert.pem";
              }
            else
              { enableACME = true; };
        };
        security.acme = {
          acceptTerms = true;
          defaults.email = "fixture@example.test";
          defaults.webroot = "/var/lib/acme/challenge";
        };
        security.pki.certificates = lib.optional (trustedCaFile != null) (builtins.readFile trustedCaFile);
      })
    ];
  };
  cfg = test.config;
  acme =
    !(builtins.elem variant [
      "manual"
      "self-signed"
      "store-key"
    ]);
  pkgs = test.pkgs;
in
{
  state = {
    failedAssertions = map (entry: entry.message) (
      builtins.filter (entry: !entry.assertion) cfg.assertions
    );
    server = cfg.systemd.services.nuschl.serviceConfig;
    after = cfg.systemd.services.nuschl.after;
    requires = cfg.systemd.services.nuschl.requires;
    helper =
      if acme && variant != "missing-host" then
        cfg.systemd.services.nuschl-tls-refresh.serviceConfig
      else
        null;
    acmeHook =
      if acme && variant != "missing-host" then
        cfg.security.acme.certs.${if variant == "reuse" then "shared.test" else "voice.test"}.postRun
      else
        null;
  };
  helperScript = pkgs.runCommand "nuschl-private-pki-helper-fixture" { } ''
    mkdir -p "$out"
    cp ${cfg.systemd.services.nuschl-tls-refresh.serviceConfig.ExecStart} "$out/refresh"
  '';
}
